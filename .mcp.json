{
  "mcpServers": {
    "aws-mcp": {
      "command": "uvx",
      "args": [
        "mcp-proxy-for-aws==1.6.0",
        "https://aws-mcp.us-east-1.api.aws/mcp",
        "--metadata",
        "AWS_REGION=us-east-1"
      ],
      "env": {
        "AWS_PROFILE": "app_cloud_devops",
        "AWS_SHARED_CREDENTIALS_FILE": "D:\\CloudDevops\\.aws\\credentials",
        "AWS_REGION": "us-east-1"
      }
    },
    "terraform": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "hashicorp/terraform-mcp-server:1.2.0"
      ]
    }
  }
}
